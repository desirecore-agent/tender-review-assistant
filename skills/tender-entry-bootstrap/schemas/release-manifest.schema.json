{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://desirecore.local/skills/tender-entry-bootstrap/release-manifest.schema.json",
  "title": "tender-entry-bootstrap release manifest (Draft-07)",
  "description": "Entry release contract. Draft allows diagnostics only. Released binds publisher-declared public platform identity and immutable team/member sources; structure does not authenticate publisher QA. Production qualification remains external to these immutable source bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestSchema",
    "packageId",
    "packageVersion",
    "status",
    "updatedAt",
    "minimumClientVersion",
    "platformRelease",
    "supportedHost",
    "team",
    "members"
  ],
  "properties": {
    "manifestSchema": {
      "type": "string",
      "const": "tender-entry-bootstrap/release-manifest/v2",
      "description": "Schema version identifier for this manifest (fixed value)."
    },
    "packageId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$",
      "description": "Skill package ID, matching the skill directory name.",
      "const": "tender-entry-bootstrap"
    },
    "packageVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
      "description": "Semantic version of this skill package (not the team repo version)."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "released"
      ],
      "description": "Publication status. draft = local only, zero install; released = real publication, installable by others."
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last modification."
    },
    "minimumClientVersion": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Minimum verified client version. null if not yet verified; never a guessed future version."
    },
    "team": {
      "description": "Team publication reference. null for draft; object with real values for released.",
      "oneOf": [
        {
          "type": "null",
          "description": "draft: no team published yet."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "url",
            "ref",
            "expectedCommit",
            "supervisorSlug"
          ],
          "properties": {
            "url": {
              "type": "string",
              "pattern": "^https://[^\\s]+$",
              "description": "Team repo HTTPS Git URL."
            },
            "ref": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "description": "Pinned 40-hex SHA for fork_team ref.",
              "minLength": 40,
              "maxLength": 40
            },
            "expectedCommit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$",
              "description": "Must equal ref — fork_team guard.",
              "minLength": 40,
              "maxLength": 40
            },
            "supervisorSlug": {
              "type": "string",
              "pattern": "^[\\w-]+$",
              "description": "Lead reviewer agent slug.",
              "const": "tender-review-lead"
            }
          }
        }
      ]
    },
    "members": {
      "description": "Team member roster. [] for draft; non-empty for released.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "slug",
          "repoUrl",
          "repoCommit",
          "agentVersion",
          "capabilities",
          "criticalAssets",
          "agentId",
          "delegationInputBinding"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "pattern": "^[\\w-]+$",
            "description": "Agent slug.",
            "enum": [
              "tender-review-lead",
              "tender-review-requirements",
              "tender-review-evidence",
              "tender-review-commercial",
              "tender-review-visual"
            ]
          },
          "repoUrl": {
            "type": "string",
            "pattern": "^https://[^\\s]+$",
            "description": "Member repo HTTPS URL."
          },
          "repoCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Pinned 40-hex commit.",
            "minLength": 40,
            "maxLength": 40
          },
          "agentVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$",
            "description": "Agent version (non-null for released)."
          },
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Required capabilities (e.g. vision)."
          },
          "criticalAssets": {
            "type": "array",
            "minItems": 1,
            "description": "Key assets with path+SHA-256 for integrity verification.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^(?!\\.{1,2}(?:/|(?![\\s\\S])))[^/\\x00-\\x1f\\\\:]+(?:/(?!\\.{1,2}(?:/|(?![\\s\\S])))[^/\\x00-\\x1f\\\\:]+)*(?![\\s\\S])",
                  "description": "Safe relative path inside the member repo. Allows normal Unicode filenames and dotfiles. Rejects exact . or .. segments, empty segments, absolute/drive paths, any backslash or colon, and C0 control characters U+0000-U+001F. The whole input must match; no trailing-newline truncation.",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$",
                  "description": "Real SHA-256 hash of the asset at publication time.",
                  "minLength": 64,
                  "maxLength": 64
                }
              }
            }
          },
          "agentId": {
            "type": "string",
            "description": "Immutable source Agent UUID, verified from actual ManageAgent-created identity.",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "delegationInputBinding": {
            "description": "Same member commit binds immutable public contract semantics; model/approval/private settings excluded.",
            "oneOf": [
              {
                "type": "object",
                "description": "No contract property is allowed in Lead installed config or pinned public seed.",
                "additionalProperties": false,
                "required": [
                  "kind"
                ],
                "properties": {
                  "kind": {
                    "const": "absent",
                    "description": "Property must be absent, not null."
                  }
                }
              },
              {
                "type": "object",
                "description": "Exact full contract derived from the same member repoCommit public agent.json. No private config hash.",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "const": "exact",
                    "description": "Four specialist contracts required."
                  },
                  "value": {
                    "type": "object",
                    "description": "Full public contract value; structural declaration is not official subset acceptance.",
                    "additionalProperties": false,
                    "required": [
                      "version",
                      "schema"
                    ],
                    "properties": {
                      "version": {
                        "const": 1,
                        "type": "integer",
                        "description": "Platform input contract version."
                      },
                      "schema": {
                        "type": [
                          "object",
                          "boolean"
                        ],
                        "description": "Complete reviewed fixed-subset schema, deep compared without rewriting. Publisher official validator and actual host capability evidence remain required."
                      }
                    }
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "slug": {
                  "const": "tender-review-lead"
                }
              }
            },
            "then": {
              "properties": {
                "delegationInputBinding": {
                  "type": "object",
                  "description": "No contract property is allowed in Lead installed config or pinned public seed.",
                  "additionalProperties": false,
                  "required": [
                    "kind"
                  ],
                  "properties": {
                    "kind": {
                      "const": "absent",
                      "description": "Property must be absent, not null."
                    }
                  }
                }
              }
            },
            "else": {
              "properties": {
                "delegationInputBinding": {
                  "type": "object",
                  "description": "Exact full contract derived from the same member repoCommit public agent.json. No private config hash.",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "value"
                  ],
                  "properties": {
                    "kind": {
                      "const": "exact",
                      "description": "Four specialist contracts required."
                    },
                    "value": {
                      "type": "object",
                      "description": "Full public contract value; structural declaration is not official subset acceptance.",
                      "additionalProperties": false,
                      "required": [
                        "version",
                        "schema"
                      ],
                      "properties": {
                        "version": {
                          "const": 1,
                          "type": "integer",
                          "description": "Platform input contract version."
                        },
                        "schema": {
                          "type": [
                            "object",
                            "boolean"
                          ],
                          "description": "Complete reviewed fixed-subset schema, deep compared without rewriting. Publisher official validator and actual host capability evidence remain required."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        ]
      }
    },
    "platformRelease": {
      "description": "Null until a real public platform release is independently established.",
      "oneOf": [
        {
          "type": "null",
          "description": "Unresolved public release."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "description": "Public publisher-declared release identity. Private assembly verifies actual release receipts; Entry checks exact bindings and local compatibility, not CI/signature authenticity.",
          "required": [
            "version",
            "sourceCommit",
            "artifactUrl",
            "artifactSha256"
          ],
          "properties": {
            "version": {
              "type": "string",
              "description": "Actual published minimum client version, equal to minimumClientVersion.",
              "pattern": "^\\d+\\.\\d+\\.\\d+$"
            },
            "sourceCommit": {
              "type": "string",
              "description": "Actual public platform source commit.",
              "pattern": "^[0-9a-f]{40}$",
              "minLength": 40,
              "maxLength": 40
            },
            "artifactUrl": {
              "type": "string",
              "description": "Public Mac arm64 release artifact HTTPS URL; no private QA paths.",
              "pattern": "^https://[^\\s]+$"
            },
            "artifactSha256": {
              "type": "string",
              "description": "SHA256 of the actual published Mac archive, independently checked by the publisher.",
              "pattern": "^[0-9a-f]{64}$",
              "minLength": 64,
              "maxLength": 64
            }
          }
        }
      ]
    },
    "supportedHost": {
      "type": "object",
      "additionalProperties": false,
      "description": "Product supported host scope; unsupported hosts stop locally, without preventing the supported Mac release.",
      "required": [
        "os",
        "architecture"
      ],
      "properties": {
        "os": {
          "type": "string",
          "description": "Supported current native OS.",
          "const": "darwin"
        },
        "architecture": {
          "type": "string",
          "description": "Supported current native architecture.",
          "const": "arm64"
        }
      }
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "draft"
      }
    }
  },
  "then": {
    "description": "Draft branch: zero fork, zero network install.",
    "properties": {
      "team": {
        "const": null
      },
      "members": {
        "maxItems": 0
      },
      "minimumClientVersion": {
        "const": null
      },
      "platformRelease": {
        "const": null
      }
    },
    "required": [
      "team",
      "members"
    ]
  },
  "else": {
    "description": "Released branch: real team and non-empty roster required.",
    "properties": {
      "team": {
        "type": "object"
      },
      "members": {
        "minItems": 5,
        "maxItems": 5
      },
      "minimumClientVersion": {
        "type": "string"
      },
      "platformRelease": {
        "type": "object"
      }
    },
    "required": [
      "team",
      "members"
    ]
  }
}
